diff --git a/MdeModulePkg/Library/LzmaCustomDecompressLib/LzmaDecompress.c b/MdeModulePkg/Library/LzmaCustomDecompressLib/LzmaDecompress.c
index 18577ac..9860a38 100644
--- a/MdeModulePkg/Library/LzmaCustomDecompressLib/LzmaDecompress.c
+++ b/MdeModulePkg/Library/LzmaCustomDecompressLib/LzmaDecompress.c
@@ -142,6 +142,9 @@ LzmaUefiDecompressGetInfo (
   )
 {
   UInt64  DecodedSize;
+  UINT8   Props;
+  UINT32  DictionarySize;
+  UINT32  NumProbs;
 
   ASSERT (SourceSize >= LZMA_HEADER_SIZE);
 
@@ -150,8 +153,22 @@ LzmaUefiDecompressGetInfo (
     return RETURN_UNSUPPORTED;
   }
 
+  //
+  // The scratch has to hold the probability model and the whole dictionary
+  // window, both of which the stream's props byte describes. The fixed
+  // 64 KiB request only fits dictionaries that small; a payload compressed
+  // with a real dictionary (ours is 8 MiB) failed to decode with
+  // SZ_ERROR_MEM because the bump allocator could not place the window.
+  //
+  Props           = ((CONST UINT8 *)Source)[0];
+  DictionarySize  = ((CONST UINT8 *)Source)[1];
+  DictionarySize |= ((CONST UINT8 *)Source)[2] << 8;
+  DictionarySize |= ((CONST UINT8 *)Source)[3] << 16;
+  DictionarySize |= ((CONST UINT8 *)Source)[4] << 24;
+  NumProbs = (1846 + (768 << ((Props % 9) + ((Props / 9) % 5)))) * sizeof (UINT16);
+  *ScratchSize = DictionarySize + NumProbs + SIZE_1KB;
+
   *DestinationSize = (UINT32)DecodedSize;
-  *ScratchSize     = SCRATCH_BUFFER_REQUEST_SIZE;
   return RETURN_SUCCESS;
 }
 
